<!DOCTYPE html>
<html lang="<%= currentLang %>" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title><%= __('admin.title') %> · <%= __('app_name') %></title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="admin-body">
<div class="container app-shell py-4">
    <div class="app-header mb-4">
        <div class="app-brand">
            <h1 class="brand-title mb-0">🍯 <%= __('app_name') %></h1>
            <p class="brand-tagline mb-1"><%= __('admin.subtitle') %></p>
            <p class="meta-copy mb-0"><%= currentUser.fullName %> · <%= currentUser.role %></p>
        </div>
        <div class="app-toolbar">
            <a class="admin-pill is-on" href="/admin"><%= __('admin.button') %></a>
            <a class="btn btn-sm btn-outline-warning" href="/"><%= __('admin.back_board') %></a>
            <form method="POST" action="/logout" class="d-inline">
                <button class="btn btn-sm btn-outline-light" type="submit"><%= __('session.logout') %></button>
            </form>
            <div class="lang-switch">
                <a href="?lang=sw" class="btn btn-sm <%= currentLang === 'sw' ? 'btn-warning' : 'btn-outline-light' %>">Kiswahili</a>
                <a href="?lang=en" class="btn btn-sm <%= currentLang === 'en' ? 'btn-warning' : 'btn-outline-light' %>">English</a>
            </div>
        </div>
    </div>

    <% if (flash) { %>
        <div class="flash flash-<%= flash.type %> mb-3"><%= flash.message %></div>
    <% } %>

    <section class="stat-grid mb-4">
        <article class="stat-card">
            <div class="stat-label"><%= __('admin.stat.users') %></div>
            <div class="stat-value"><%= overview.counts.users %></div>
        </article>
        <article class="stat-card accent-pending">
            <div class="stat-label"><%= __('admin.stat.pending') %></div>
            <div class="stat-value"><%= overview.counts.pending %></div>
        </article>
        <article class="stat-card">
            <div class="stat-label"><%= __('admin.stat.online') %></div>
            <div class="stat-value"><%= overview.counts.online %></div>
        </article>
        <article class="stat-card">
            <div class="stat-label"><%= __('admin.stat.logins') %></div>
            <div class="stat-value"><%= overview.counts.loginsToday %></div>
        </article>
        <article class="stat-card">
            <div class="stat-label"><%= __('admin.stat.live') %></div>
            <div class="stat-value"><%= overview.counts.liveMatches %></div>
        </article>
        <article class="stat-card">
            <div class="stat-label"><%= __('admin.stat.matches') %></div>
            <div class="stat-value"><%= overview.counts.matches %></div>
        </article>
        <article class="stat-card">
            <div class="stat-label"><%= __('admin.stat.visits') %></div>
            <div class="stat-value"><%= overview.counts.visitsToday %></div>
        </article>
        <article class="stat-card">
            <div class="stat-label"><%= __('admin.stat.resets') %></div>
            <div class="stat-value"><%= overview.counts.resets %></div>
        </article>
    </section>

    <div class="admin-grid">
        <section class="card board-panel p-3">
            <h2 class="section-heading"><%= __('admin.add_user') %></h2>
            <form id="admin-create-user" class="row g-2">
                <div class="col-12">
                    <label class="form-label"><%= __('auth.full_name') %></label>
                    <input name="fullName" class="form-control bg-dark text-light border-secondary" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label"><%= __('auth.email') %></label>
                    <input name="email" type="email" class="form-control bg-dark text-light border-secondary" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label"><%= __('auth.username') %></label>
                    <input name="username" class="form-control bg-dark text-light border-secondary" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label"><%= __('auth.password') %></label>
                    <input name="password" type="password" minlength="8" class="form-control bg-dark text-light border-secondary" required>
                </div>
                <% if (canSettings) { %>
                <div class="col-md-6">
                    <label class="form-label"><%= __('admin.role') %></label>
                    <select name="role" class="form-control bg-dark text-light border-secondary">
                        <option value="USER">USER</option>
                        <option value="MANAGER">MANAGER</option>
                    </select>
                </div>
                <% } %>
                <div class="col-12">
                    <button class="btn btn-warning fw-bold" type="submit"><%= __('admin.create_user') %></button>
                </div>
                <p class="meta-copy mb-0" id="create-user-status"></p>
            </form>
        </section>

        <section class="card board-panel p-3">
            <h2 class="section-heading"><%= __('admin.pending_title') %></h2>
            <% if (!pending.length) { %>
                <p class="empty-copy mb-0"><%= __('admin.pending_empty') %></p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-dark table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th><%= __('auth.full_name') %></th>
                                <th><%= __('auth.email') %></th>
                                <th><%= __('auth.username') %></th>
                                <% if (canApprove) { %><th></th><% } %>
                            </tr>
                        </thead>
                        <tbody>
                        <% pending.forEach((user) => { %>
                            <tr>
                                <td><%= user.full_name %></td>
                                <td><%= user.email %></td>
                                <td><%= user.username %></td>
                                <% if (canApprove) { %>
                                <td class="text-nowrap">
                                    <button class="btn btn-sm btn-success js-approve" data-id="<%= user.id %>"><%= __('admin.accept') %></button>
                                    <button class="btn btn-sm btn-outline-danger js-reject" data-id="<%= user.id %>"><%= __('admin.reject') %></button>
                                </td>
                                <% } %>
                            </tr>
                        <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>

        <% if (canSettings) { %>
        <section class="card board-panel p-3">
            <h2 class="section-heading"><%= __('admin.settings_title') %></h2>
            <form id="admin-settings" class="row g-2">
                <div class="col-6">
                    <label class="form-label"><%= __('admin.tamu_min') %></label>
                    <input name="tamuMin" type="number" step="0.01" value="<%= overview.prefs.tamu.minOdds %>" class="form-control bg-dark text-light border-secondary">
                </div>
                <div class="col-6">
                    <label class="form-label"><%= __('admin.tamu_max') %></label>
                    <input name="tamuMax" type="number" step="0.01" value="<%= overview.prefs.tamu.maxOdds %>" class="form-control bg-dark text-light border-secondary">
                </div>
                <div class="col-6">
                    <label class="form-label"><%= __('admin.chungu_min') %></label>
                    <input name="chunguMin" type="number" step="0.01" value="<%= overview.prefs.chungu.minOdds %>" class="form-control bg-dark text-light border-secondary">
                </div>
                <div class="col-6">
                    <label class="form-label"><%= __('admin.chungu_max') %></label>
                    <input name="chunguMax" type="number" step="0.01" value="<%= overview.prefs.chungu.maxOdds %>" class="form-control bg-dark text-light border-secondary">
                </div>
                <div class="col-6">
                    <label class="form-label"><%= __('filters.max_matches') %></label>
                    <input name="limit" type="number" value="<%= overview.prefs.limit %>" class="form-control bg-dark text-light border-secondary">
                </div>
                <div class="col-12">
                    <button class="btn btn-warning fw-bold" type="submit"><%= __('admin.save_prefs') %></button>
                </div>
                <p class="meta-copy mb-0" id="settings-status"></p>
            </form>
            <hr class="border-secondary">
            <p class="meta-copy" id="fetch-stamp">
                <%= __('updated_prefix') %>:
                <%= overview.cache.lastFetchAt ? new Date(overview.cache.lastFetchAt).toLocaleString(currentLang === 'sw' ? 'sw-TZ' : 'en-TZ', { timeZone: 'Africa/Dar_es_Salaam' }) : __('updated_never') %>
            </p>
            <button class="btn btn-outline-info" type="button" id="admin-fetch"><%= __('admin.fetch_now') %></button>
            <p class="meta-copy mt-2 mb-0" id="fetch-status"></p>
        </section>

        <section class="card board-panel p-3">
            <h2 class="section-heading"><%= __('admin.resets_title') %></h2>
            <% if (!resets.length) { %>
                <p class="empty-copy mb-0"><%= __('admin.resets_empty') %></p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-dark table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th><%= __('auth.full_name') %></th>
                                <th><%= __('auth.email') %></th>
                                <th><%= __('admin.status') %></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        <% resets.forEach((row) => { %>
                            <tr>
                                <td><%= row.full_name %></td>
                                <td><%= row.email %></td>
                                <td><%= row.status %></td>
                                <td>
                                    <button class="btn btn-sm btn-warning js-issue-reset" data-id="<%= row.id %>"><%= __('admin.issue_reset') %></button>
                                </td>
                            </tr>
                        <% }) %>
                        </tbody>
                    </table>
                </div>
                <p class="meta-copy mt-2 mb-0" id="reset-status"></p>
            <% } %>
        </section>

        <section class="card board-panel p-3">
            <h2 class="section-heading"><%= __('admin.online_title') %></h2>
            <% if (!online.length) { %>
                <p class="empty-copy mb-0"><%= __('admin.online_empty') %></p>
            <% } else { %>
                <% online.forEach((user) => { %>
                    <div class="acca-leg">
                        <span class="fixture-name"><%= user.full_name %><br><span class="meta-copy"><%= user.role %> · <%= user.email %></span></span>
                        <strong class="online-dot">●</strong>
                    </div>
                <% }) %>
            <% } %>
        </section>

        <section class="card board-panel p-3 admin-span">
            <h2 class="section-heading"><%= __('admin.users_title') %></h2>
            <div class="table-responsive">
                <table class="table table-dark table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th><%= __('auth.full_name') %></th>
                            <th><%= __('auth.username') %></th>
                            <th><%= __('auth.email') %></th>
                            <th><%= __('admin.role') %></th>
                            <th><%= __('admin.status') %></th>
                            <th><%= __('admin.logins_col') %></th>
                        </tr>
                    </thead>
                    <tbody>
                    <% users.forEach((user) => { %>
                        <tr>
                            <td><%= user.full_name %></td>
                            <td><%= user.username %></td>
                            <td><%= user.email %></td>
                            <td><%= user.role %></td>
                            <td><%= user.status %></td>
                            <td><%= user.login_count %></td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
        <% } %>

        <section class="card board-panel p-3 admin-span">
            <h2 class="section-heading"><%= __('admin.recent_title') %></h2>
            <% if (!overview.recentLogins.length) { %>
                <p class="empty-copy mb-0"><%= __('admin.recent_empty') %></p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-dark table-sm mb-0">
                        <thead>
                            <tr>
                                <th><%= __('auth.full_name') %></th>
                                <th><%= __('admin.role') %></th>
                                <th><%= __('admin.when') %></th>
                                <th><%= __('admin.board_seen') %></th>
                            </tr>
                        </thead>
                        <tbody>
                        <% overview.recentLogins.forEach((row) => { %>
                            <tr>
                                <td><%= row.full_name %></td>
                                <td><%= row.role %></td>
                                <td><%= new Date(row.started_at).toLocaleString(currentLang === 'sw' ? 'sw-TZ' : 'en-TZ', { timeZone: 'Africa/Dar_es_Salaam' }) %></td>
                                <td>
                                    <%= row.live_count != null ? `${row.live_count} live · ${row.today_count || 0} today` : '—' %>
                                </td>
                            </tr>
                        <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    </div>
</div>
<script type="application/json" id="admin-boot"><%- JSON.stringify({
  canApprove,
  canSettings,
  labels: {
    created: __('admin.created_ok'),
    created_pending: __('admin.created_pending'),
    saved: __('admin.saved'),
    fetched: __('admin.fetched'),
    reset_issued: __('admin.reset_issued'),
    failed: __('admin.failed'),
    accept: __('admin.accept'),
    reject: __('admin.reject')
  }
}).replace(/</g, '\\u003c') %></script>
<script type="module" src="/js/admin.js"></script>
</body>
</html>
