<!DOCTYPE html>
<html lang="<%= currentLang %>" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title><%= typeof title !== 'undefined' ? title : __('app_name') %> · <%= __('app_name') %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="auth-body">
<div class="auth-shell">
    <header class="auth-brand">
        <h1 class="brand-title mb-0">🍯 <%= __('app_name') %></h1>
        <p class="brand-tagline mb-0"><%= __('tagline') %></p>
        <div class="lang-switch mt-3">
            <a href="?lang=sw" class="btn btn-sm <%= currentLang === 'sw' ? 'btn-warning' : 'btn-outline-light' %>">Kiswahili</a>
            <a href="?lang=en" class="btn btn-sm <%= currentLang === 'en' ? 'btn-warning' : 'btn-outline-light' %>">English</a>
        </div>
    </header>
    <main class="card auth-card p-4">
        <% if (typeof heading !== 'undefined') { %>
            <h2 class="section-heading"><%= heading %></h2>
        <% } %>
        <% if (typeof flash !== 'undefined' && flash) { %>
            <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
        <% } %>
